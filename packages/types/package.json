{
  "name": "@pr-pm/types",
  "version": "2.1.5",
  "description": "Shared TypeScript types for Prompt Package Manager",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "echo 'No unit tests for types package - use npm run typecheck to validate'"
  },
  "keywords": [
    "prpm",
    "types",
    "typescript"
  ],
  "author": "khaliqgant",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pr-pm/prpm.git",
    "directory": "packages/types"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
